---
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">

	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />

		<meta
			name="description"
			content="Independent Writing — WEIYOU LI"
		/>

		<title>
			Independent Writing — WEIYOU LI
		</title>
	</head>


	<body>

		<!-- ==================================================
		     NAVIGATION
		================================================== -->

		<header class="navbar">

			<a
				class="logo"
				href={`${base}/`}
			>
				WEIYOU LI
			</a>


			<nav>

				<a href={`${base}/#about`}>
					About
				</a>

				<a href={`${base}/#work`}>
					Work
				</a>

				<a href={`${base}/photography/`}>
					Photography
				</a>

				<a href={`${base}/#notes`}>
					Notes & Writing
				</a>

			</nav>

		</header>


		<main>

			<!-- ==================================================
			     HERO
			================================================== -->

			<section class="hero">

				<div class="hero-small">

					<p>
						Notes & Writing / 03
					</p>

					<p>
						Independent Writing
					</p>

				</div>


				<h1>
					Independent<br />
					Writing.
				</h1>


				<div class="hero-bottom">

					<p>
						Essays, project notes, and ideas<br />
						developed outside formal coursework.
					</p>

					<a href="#writing">
						Explore ↓
					</a>

				</div>

			</section>


			<!-- ==================================================
			     WRITING IN PROGRESS
			================================================== -->

			<section
				id="writing"
				class="section"
			>

				<div class="section-number">
					03 — Independent Writing
				</div>


				<div class="writing-intro">

					<p class="eyebrow">
						Writing in progress
					</p>


					<h2>
						A space for ideas<br />
						that need more room.
					</h2>


					<div class="writing-copy">

						<p>
							This section will collect independent essays,
							project notes, and reflections on mathematics,
							machine learning, research, and other ideas I
							want to explore more deeply.
						</p>

						<p>
							I’m currently using this space to develop
							longer-form writing alongside my research and
							technical work.
						</p>

					</div>

				</div>


				<!-- ==================================================
				     FIRST PIECE PLACEHOLDER
				================================================== -->

				<div class="coming-soon">

					<div class="coming-number">
						01
					</div>


					<div class="coming-title">

						<span>
							First piece
						</span>

						<h3>
							Currently taking shape.
						</h3>

					</div>


					<div class="coming-status">
						Coming soon
					</div>

				</div>


				<!-- ==================================================
				     THEMES
				================================================== -->

				<div class="themes">

					<div class="themes-label">
						Possible directions
					</div>


					<div class="themes-list">

						<span>
							Mathematics
						</span>

						<span>
							Machine Learning
						</span>

						<span>
							Research
						</span>

						<span>
							Projects
						</span>

						<span>
							Data
						</span>

						<span>
							Ideas
						</span>

					</div>

				</div>

			</section>

		</main>


		<!-- ==================================================
		     FOOTER
		================================================== -->

		<footer>

			<div>
				WEIYOU LI
			</div>


			<div class="footer-links">

				<a
					href="https://github.com/Shercroft"
					target="_blank"
					rel="noopener noreferrer"
				>
					GitHub
				</a>


				<a
					href="https://www.linkedin.com/in/weiyou-li-032426252/"
					target="_blank"
					rel="noopener noreferrer"
				>
					LinkedIn
				</a>


				<a href="mailto:miloliwy@gmail.com">
					Email
				</a>

			</div>


			<div>
				© 2026
			</div>

		</footer>

	</body>

</html>


<style>

	/* ==================================================
	   GLOBAL
	================================================== */

	:root {
		--serif:
			Georgia,
			"Times New Roman",
			serif;

		--background:
			#f2f0e9;

		--text:
			#111;

		--line:
			#aaa69c;

		--muted:
			#666;
	}


	* {
		box-sizing:
			border-box;
	}


	html {
		scroll-behavior:
			smooth;
	}


	body {
		margin:
			0;

		background:
			#f2f0e9;

		color:
			var(--text);

		font-family:
			Arial,
			Helvetica,
			sans-serif;

		font-size:
			15px;
	}


	a {
		color:
			inherit;

		text-decoration:
			none;
	}


	/* ==================================================
	   NAVIGATION
	================================================== */

	.navbar {
		position:
			absolute;

		top:
			0;

		left:
			0;

		z-index:
			10;

		display:
			flex;

		align-items:
			center;

		justify-content:
			space-between;

		width:
			100%;

		padding:
			28px
			4vw;
	}


	.logo {
		font-weight:
			600;

		letter-spacing:
			0.08em;
	}


	nav {
		display:
			flex;

		gap:
			32px;
	}


	nav a {
		transition:
			opacity
			0.2s
			ease;
	}


	nav a:hover {
		opacity:
			0.45;
	}


	/* ==================================================
	   HERO
	================================================== */

	.hero {
		display:
			flex;

		flex-direction:
			column;

		justify-content:
			center;

		min-height:
			100vh;

		padding:
			130px
			4vw
			50px;
	}


	.hero-small {
		display:
			flex;

		justify-content:
			space-between;

		margin-bottom:
			35px;

		font-size:
			11px;

		text-transform:
			uppercase;

		letter-spacing:
			0.12em;
	}


	.hero h1 {
		margin:
			0;

		font-family:
			var(--serif);

		font-size:
			clamp(
				70px,
				10vw,
				165px
			);

		font-weight:
			400;

		line-height:
			0.9;

		letter-spacing:
			-0.055em;
	}


	.hero-bottom {
		display:
			flex;

		align-items:
			flex-end;

		justify-content:
			space-between;

		margin-top:
			auto;

		line-height:
			1.5;
	}


	.hero-bottom a {
		padding-bottom:
			3px;

		border-bottom:
			1px solid
				transparent;

		transition:
			border-color
			0.2s
			ease;
	}


	.hero-bottom a:hover {
		border-color:
			#111;
	}


	/* ==================================================
	   MAIN SECTION
	================================================== */

	.section {
		padding:
			100px
			4vw
			150px;

		border-top:
			1px solid
				var(--line);
	}


	.section-number {
		margin-bottom:
			100px;

		font-size:
			11px;

		text-transform:
			uppercase;

		letter-spacing:
			0.1em;
	}


	/* ==================================================
	   WRITING INTRO
	================================================== */

	.writing-intro {
		display:
			grid;

		grid-template-columns:
			1fr
			2fr;

		column-gap:
			70px;

		padding-bottom:
			100px;
	}


	.eyebrow {
		margin:
			10px
			0
			0;

		font-size:
			11px;

		text-transform:
			uppercase;

		letter-spacing:
			0.12em;

		color:
			var(--muted);
	}


	.writing-intro h2 {
		grid-column:
			2;

		margin:
			0;

		max-width:
			1000px;

		font-family:
			var(--serif);

		font-size:
			clamp(
				55px,
				7vw,
				110px
			);

		font-weight:
			400;

		line-height:
			0.92;

		letter-spacing:
			-0.05em;
	}


	.writing-copy {
		grid-column:
			2;

		max-width:
			680px;

		margin-top:
			60px;
	}


	.writing-copy p {
		margin:
			0
			0
			24px;

		font-size:
			17px;

		line-height:
			1.65;
	}


	/* ==================================================
	   COMING SOON
	================================================== */

	.coming-soon {
		display:
			grid;

		grid-template-columns:
			70px
			1fr
			auto;

		align-items:
			center;

		gap:
			30px;

		padding:
			38px
			0;

		border-top:
			1px solid
				var(--line);

		border-bottom:
			1px solid
				var(--line);
	}


	.coming-number {
		font-size:
			11px;

		color:
			var(--muted);

		letter-spacing:
			0.08em;
	}


	.coming-title > span {
		display:
			block;

		margin-bottom:
			8px;

		font-size:
			10px;

		text-transform:
			uppercase;

		letter-spacing:
			0.12em;

		color:
			var(--muted);
	}


	.coming-title h3 {
		margin:
			0;

		font-family:
			var(--serif);

		font-size:
			clamp(
				28px,
				3vw,
				44px
			);

		font-weight:
			400;

		letter-spacing:
			-0.025em;
	}


	.coming-status {
		padding:
			9px
			14px;

		border:
			1px solid
				var(--line);

		border-radius:
			999px;

		font-size:
			10px;

		text-transform:
			uppercase;

		letter-spacing:
			0.1em;

		color:
			var(--muted);
	}


	/* ==================================================
	   THEMES
	================================================== */

	.themes {
		display:
			grid;

		grid-template-columns:
			1fr
			2fr;

		gap:
			70px;

		margin-top:
			90px;
	}


	.themes-label {
		padding-top:
			9px;

		font-size:
			10px;

		text-transform:
			uppercase;

		letter-spacing:
			0.12em;

		color:
			var(--muted);
	}


	.themes-list {
		display:
			flex;

		flex-wrap:
			wrap;

		gap:
			10px;
	}


	.themes-list span {
		padding:
			9px
			15px;

		border:
			1px solid
				var(--line);

		border-radius:
			999px;

		font-size:
			12px;
	}


	/* ==================================================
	   FOOTER
	================================================== */

	footer {
		display:
			flex;

		align-items:
			center;

		justify-content:
			space-between;

		padding:
			40px
			4vw;

		background:
			#111;

		color:
			#f2f0e9;
	}


	.footer-links {
		display:
			flex;

		gap:
			25px;
	}


	.footer-links a {
		transition:
			opacity
			0.2s
			ease;
	}


	.footer-links a:hover {
		opacity:
			0.5;
	}


	/* ==================================================
	   MOBILE
	================================================== */

	@media (max-width: 800px) {

		.navbar {
			align-items:
				flex-start;
		}


		nav {
			flex-direction:
				column;

			gap:
				8px;
		}


		.hero h1 {
			font-size:
				18vw;
		}


		.hero-bottom {
			gap:
				30px;
		}


		.writing-intro {
			grid-template-columns:
				1fr;

			row-gap:
				25px;
		}


		.eyebrow,
		.writing-intro h2,
		.writing-copy {
			grid-column:
				1;
		}


		.writing-copy {
			margin-top:
				25px;
		}


		.coming-soon {
			grid-template-columns:
				45px
				1fr;

			gap:
				20px;
		}


		.coming-status {
			grid-column:
				2;

			justify-self:
				start;
		}


		.themes {
			grid-template-columns:
				1fr;

			gap:
				25px;
		}


		footer {
			flex-direction:
				column;

			align-items:
				flex-start;

			gap:
				30px;
		}

	}

</style>
