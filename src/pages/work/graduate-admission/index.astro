---
import ProjectLayout from "../../../layouts/ProjectLayout.astro";
---

<ProjectLayout
	title="Graduate Admission Modeling"
	category="Statistics · Machine Learning"
	year="2026"
	summary="A comparative modeling study examining neural-network and regression approaches to graduate-admission prediction."
>

	<div class="project-block">

		<div class="project-label">
			Overview
		</div>

		<div class="project-main">

			<h2>
				Comparing statistical and neural approaches.
			</h2>

			<p>
				This project studies graduate-admission prediction
				through two different modeling approaches: an
				artificial neural network and a regression model.
			</p>

			<p>
				The goal is to compare their predictive performance
				and examine how a conventional statistical model
				differs from a machine-learning approach on the
				same dataset.
			</p>

			<div class="project-tags">

				<span>Statistics</span>
				<span>Neural Networks</span>
				<span>Regression</span>
				<span>Python</span>
				<span>Data Analysis</span>

			</div>

		</div>

	</div>


	<div class="project-block">

		<div class="project-label">
			Deliverables
		</div>

		<div class="project-main">

			<h2>
				Analysis, implementation and report.
			</h2>

			<p>
				The repository contains the complete analysis notebook
				along with a written report documenting the methodology
				and results.
			</p>

			<div class="project-links">

				<a
					href="https://github.com/Shercroft/Graduate-Admission"
					target="_blank"
					rel="noopener noreferrer"
				>
					View GitHub ↗
				</a>

				<a
					href="https://github.com/Shercroft/Graduate-Admission/blob/main/Chance_of_Admit_Report.pdf"
					target="_blank"
					rel="noopener noreferrer"
				>
					Read Report ↗
				</a>

				<a
					href="https://github.com/Shercroft/Graduate-Admission/blob/main/chance-of-admit-via-ann-lr.ipynb"
					target="_blank"
					rel="noopener noreferrer"
				>
					View Notebook ↗
				</a>

			</div>

		</div>

	</div>

</ProjectLayout>
