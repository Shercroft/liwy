					<span class="pipeline-number">
						03
					</span>

					<div class="pipeline-content">

						<h3>
							Prepare
						</h3>

						<p>
							Split the data and standardize the predictor
							variables.
						</p>

					</div>

				</div>


				<div class="pipeline-step">

					<span class="pipeline-number">
						04
					</span>

					<div class="pipeline-content">

						<h3>
							Train
						</h3>

						<p>
							Fit logistic-regression and neural-network
							classifiers using the same feature set.
						</p>

					</div>

				</div>


				<div class="pipeline-step">

					<span class="pipeline-number">
						05
					</span>

					<div class="pipeline-content">

						<h3>
							Evaluate
						</h3>

						<p>
							Compare validation accuracy, AUC and ROC
							behavior.
						</p>

					</div>

				</div>


				<div class="pipeline-step">

					<span class="pipeline-number">
						06
					</span>

					<div class="pipeline-content">

						<h3>
							Interpret
						</h3>

						<p>
							Assess whether additional model complexity
							provides a meaningful advantage.
						</p>

					</div>

				</div>

			</div>

		</div>

	</div>


	<!-- =====================================================
	     09 — TOOLS
	===================================================== -->

